{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braid",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "braid-demo", "remote": true }]
}
