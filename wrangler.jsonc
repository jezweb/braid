{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braid",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "LANE", "class_name": "Lane" },
      { "name": "MERGE_AGENT", "class_name": "MergeAgent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lane", "MergeAgent"] }],
  "ai": { "binding": "AI" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "braid-demo", "remote": true }]
}
