{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "braid",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./dist/viewer", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/approve/api/*", "/spike/*"] },
  "vars": { "REPO": "harbourne", "PERSON_AGENT": "person", "DEMO_ACTOR": "demo-person@braid.invalid" },
  "durable_objects": {
    "bindings": [
      { "name": "LANE", "class_name": "Lane" },
      { "name": "MERGE_AGENT", "class_name": "MergeAgent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lane", "MergeAgent"] }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "READS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "braid-demo", "remote": true }]
}
